rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net - Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives & Functions ---
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "deeptoneblack@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // --- Validation Rules ---
    function isValidUserDoc(data) {
      return (!data.keys().contains('uid') || data.uid == request.auth.uid) &&
             (!data.keys().contains('username') || (data.username is string && data.username.size() >= 2 && data.username.size() <= 50)) &&
             (!data.keys().contains('avatarId') || (data.avatarId is string && data.avatarId.size() <= 50)) &&
             (!data.keys().contains('avatarBg') || (data.avatarBg is string && data.avatarBg.size() <= 100)) &&
             (!data.keys().contains('isOnline') || data.isOnline is bool) &&
             (!data.keys().contains('statusMessage') || data.statusMessage is string) &&
             (!data.keys().contains('favorites') || data.favorites is list);
    }

    function isValidMessageDoc(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.channel is string && data.channel.size() <= 100 &&
             data.author is string && data.author.size() <= 50 &&
             data.avatarId is string && data.avatarId.size() <= 50 &&
             data.avatarBg is string && data.avatarBg.size() <= 100 &&
             data.text is string && data.text.size() <= 2000 &&
             data.date is string && data.date.size() <= 50 &&
             (resource == null ? data.createdAt == request.time : data.createdAt == resource.data.createdAt);
    }

    function isValidGameDoc(data) {
      return data.id is int &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 250;
    }

    function isValidReviewDoc(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.gameId is int &&
             data.author is string && data.author.size() <= 50 &&
             data.rating is int && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 2000 &&
             data.recommend is bool &&
             data.date is string && data.date.size() <= 50 &&
             (resource == null ? data.createdAt == request.time : data.createdAt == resource.data.createdAt);
    }

    function isValidEventDoc(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.gameId is int &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 200 &&
             data.organizer is string && data.organizer.size() <= 100 &&
             data.date is string && data.date.size() <= 50 &&
             data.maxPlayers is int && data.maxPlayers >= 2 && data.maxPlayers <= 100 &&
             data.players is list && data.players.size() <= data.maxPlayers &&
             (resource == null ? data.createdAt == request.time : data.createdAt == resource.data.createdAt);
    }

    function isValidEventCommentDoc(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.author is string && data.author.size() <= 100 &&
             data.text is string && data.text.size() <= 2000 &&
             data.date is string && data.date.size() <= 100 &&
             (resource == null ? data.createdAt == request.time : data.createdAt == resource.data.createdAt);
    }

    // --- Path Mappings ---

    // USERS profiles - Allow reading by anyone signed in, allow editing/deleting by the profile owner or managers
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // CHAT messages - Allow read/write for any signed in users
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // GAMES store data - Publicly readable, modifiable by signed in players
    match /games/{gameId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // REVIEWS for games - Publicly readable, modifiable by signed in players
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // EVENTS lobbies - Read and write access for signed in users
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
      
      // Subcollection: comments
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }
    }
  }
}
